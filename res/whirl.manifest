<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Application manifest of whirl.exe / whirl-server.exe (embedded by the
     linker; cmake/release.cmake links them with /MANIFESTUAC:NO so this file
     is the only source of trustInfo).
     SPDX-License-Identifier: Apache-2.0 -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- runs as the calling user: no administrator rights, no UAC prompt -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- the process ANSI code page is UTF-8: narrow paths / environment are UTF-8 -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <!-- paths longer than MAX_PATH work when long paths are enabled in Windows -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
