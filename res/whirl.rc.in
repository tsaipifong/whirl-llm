// Windows resources of a WHIRL executable (generated per target by
// cmake/release.cmake from res/whirl.rc.in).
// SPDX-License-Identifier: Apache-2.0

#include <winver.h>

@WHIRL_RC_ICON_LINE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WHIRL"
            VALUE "FileDescription",  "@WHIRL_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@WHIRL_RC_INTERNAL@"
            VALUE "LegalCopyright",   "Copyright (C) 2026 tsaipifong. Licensed under the Apache License 2.0."
            VALUE "OriginalFilename", "@WHIRL_RC_ORIGINAL@"
            VALUE "ProductName",      "WHIRL"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
