    tail[0] = sl.next;
    for (std::uint32_t r = 0; r <= acc; ++r) tail[r + 1] = dr[r];
    return relax::extendsRepeat(std::span<const std::uint32_t>(sl.cache_tokens), std::span<const std::uint32_t>(tail.data(), acc + 2));
}
