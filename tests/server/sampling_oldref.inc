bool filterCands(Sampler& s, std::size_t count, bool complete) {
    std::vector<Cand>& cv = *s.cands;
    Cand* c = cv.data();
    std::sort(c, c + count, [](const Cand& x, const Cand& y) {
        if (x.logit != y.logit) return x.logit > y.logit;
        return x.id < y.id;
    });
    if (complete) {
